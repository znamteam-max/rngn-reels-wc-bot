{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "python -m pip install -r requirements.txt",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,.wrangler/**,public/**,releases/**,reference/**,src/**,test/**,tests/**,*.md,package-lock.json,wrangler.toml,wrangler.toml.example}"
    },
    "api/internal/kick-worker.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/internal/archive-world-cup-2026-5d9f7a2c91.py",
      "destination": "/api/internal/archive-world-cup-2026-5d9f7a2c91"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/youtube-metrics",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 6 * * *"
    }
  ]
}
